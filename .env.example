# Local development defaults. Copy to .env and replace secrets.
# Never commit a real .env file.

NODE_ENV=development
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://127.0.0.1:6379

# Leave empty to use PostgreSQL full-text search.
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=products

# Generate long random strings for any shared environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
MOCK_WEBHOOK_SECRET=replace-with-a-webhook-secret

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Optional S3-compatible storage. Local disk is used when these are empty.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Optional Stripe test mode. Mock payments are used when STRIPE_SECRET_KEY is empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional SMTP. Development mail is stored and shown at GET /api/v1/dev/mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Northstar <hello@northstar.market>"

RATE_LIMIT_DISABLED=false
LOG_LEVEL=info
