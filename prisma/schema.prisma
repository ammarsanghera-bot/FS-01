generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum CustomerOrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum VendorOrderStatus {
  PENDING
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum CouponType {
  FIXED
  PERCENTAGE
  FREE_SHIPPING
}

enum CommissionSource {
  GLOBAL
  VENDOR
  CATEGORY
}

enum LedgerType {
  GROSS
  COMMISSION
  SHIPPING
  REFUND
  COMMISSION_REVERSAL
  PAYOUT
  ADJUSTMENT
}

enum InventoryMovementType {
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  REFUND
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShipmentStatus {
  LABEL_CREATED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  passwordHash                 String
  role                         Role
  status                       UserStatus @default(ACTIVE)
  firstName                    String
  lastName                     String
  phone                        String?
  emailVerifiedAt              DateTime?
  emailVerificationTokenHash   String?
  passwordResetTokenHash       String?
  passwordResetExpiresAt       DateTime?
  deletedAt                    DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  customerProfile     CustomerProfile?
  vendorProfile       VendorProfile?
  vendorApplication   VendorApplication?
  reviewedApplications VendorApplication[] @relation("ReviewedApplications")
  addresses           Address[]
  refreshTokens       RefreshToken[]
  cart                Cart?
  wishlist            Wishlist?
  orders              CustomerOrder[]
  reviews             Review[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  couponUsages        CouponUsage[]

  @@index([role, status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  marketingOptIn  Boolean @default(false)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  legalName        String
  taxId            String?
  phone            String?
  status           VendorStatus @default(PENDING)
  stripeAccountId  String?
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store            Store?
}

model VendorApplication {
  id              String       @id @default(cuid())
  userId          String       @unique
  storeName       String
  slug            String
  description     String
  contactEmail    String
  phone           String?
  city            String?
  region          String?
  country         String?
  legalName       String
  taxId           String?
  returnPolicy    String?
  shippingPolicy  String?
  status          VendorStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?        @relation("ReviewedApplications", fields: [reviewedById], references: [id])

  @@index([status])
}

model Store {
  id                String       @id @default(cuid())
  vendorProfileId   String       @unique
  name              String
  slug              String       @unique
  logoUrl           String?
  coverUrl          String?
  description       String
  contactEmail      String
  phone             String?
  city              String?
  region            String?
  country           String?
  status            VendorStatus @default(APPROVED)
  returnPolicy      String?
  shippingPolicy    String?
  ratingAvg         Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount       Int          @default(0)
  commissionRate    Decimal?     @db.Decimal(5, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  vendorProfile     VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  products          Product[]
  vendorOrders      VendorOrder[]
  coupons           Coupon[]
  ledger            VendorLedger[]
  payouts           Payout[]
  settings          StoreSetting[]

  @@index([status])
}

model Address {
  id                 String  @id @default(cuid())
  userId             String
  label              String?
  fullName           String
  line1              String
  line2              String?
  city               String
  state              String
  postalCode         String
  country            String  @default("US")
  phone              String?
  isDefaultShipping  Boolean @default(false)
  isDefaultBilling   Boolean @default(false)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String
  imageUrl        String?
  parentId        String?
  commissionRate  Decimal?   @db.Decimal(5, 2)
  isActive        Boolean    @default(true)
  sortOrder       Int        @default(0)
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  products        Product[]

  @@index([parentId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  products    Product[]
}

model Product {
  id               String        @id @default(cuid())
  storeId          String
  categoryId       String
  brandId          String?
  name             String
  slug             String        @unique
  sku              String        @unique
  description      String
  shortDescription String
  price            Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2)
  status           ProductStatus @default(DRAFT)
  rejectionReason  String?
  weightGrams      Int?
  lengthCm         Decimal?      @db.Decimal(8, 2)
  widthCm          Decimal?      @db.Decimal(8, 2)
  heightCm         Decimal?      @db.Decimal(8, 2)
  shippingInfo     String?
  tags             String[]
  ratingAvg        Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  salesCount       Int           @default(0)
  isFeatured       Boolean       @default(false)
  publishedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  store            Store         @relation(fields: [storeId], references: [id])
  category         Category      @relation(fields: [categoryId], references: [id])
  brand            Brand?        @relation(fields: [brandId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  inventory        Inventory[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reviews          Review[]

  @@index([status, categoryId])
  @@index([storeId, status])
  @@index([salesCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  sku            String      @unique
  name           String
  options        Json
  price          Decimal?    @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
}

model ProductAttribute {
  id        String                  @id @default(cuid())
  productId String
  name      String
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductAttributeValue[]

  @@index([productId])
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  attributeId String
  value       String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
}

model Inventory {
  id                 String              @id @default(cuid())
  productId          String
  variantId          String              @unique
  quantity           Int
  reserved           Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements          InventoryMovement[]

  @@index([productId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  inventoryId   String
  type          InventoryMovementType
  onHandDelta   Int
  reservedDelta Int
  reason        String?
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime              @default(now())
  inventory     Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  sessionId  String?    @unique
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String?        @unique
  sessionId String?        @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model CustomerOrder {
  id               String              @id @default(cuid())
  orderNumber      String              @unique
  userId           String
  status           CustomerOrderStatus
  currency         String              @default("USD")
  subtotal         Decimal             @db.Decimal(10, 2)
  discount         Decimal             @default(0) @db.Decimal(10, 2)
  shipping         Decimal             @default(0) @db.Decimal(10, 2)
  tax              Decimal             @default(0) @db.Decimal(10, 2)
  grandTotal       Decimal             @db.Decimal(10, 2)
  shippingMethod   String
  couponId         String?
  couponCode       String?
  billingAddress   Json
  shippingAddress  Json
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id])
  coupon           Coupon?             @relation(fields: [couponId], references: [id])
  vendorOrders     VendorOrder[]
  items            OrderItem[]
  payments         Payment[]
  refunds          Refund[]
  events           OrderEvent[]
  couponUsages     CouponUsage[]

  @@index([userId, createdAt])
  @@index([status])
}

model VendorOrder {
  id               String            @id @default(cuid())
  orderNumber      String            @unique
  customerOrderId  String
  storeId          String
  status           VendorOrderStatus @default(PENDING)
  subtotal         Decimal           @db.Decimal(10, 2)
  discount         Decimal           @default(0) @db.Decimal(10, 2)
  shipping         Decimal           @default(0) @db.Decimal(10, 2)
  tax              Decimal           @default(0) @db.Decimal(10, 2)
  commissionAmount Decimal           @db.Decimal(10, 2)
  vendorEarnings   Decimal           @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customerOrder    CustomerOrder     @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  store            Store             @relation(fields: [storeId], references: [id])
  items            OrderItem[]
  shipments        Shipment[]
  commissions      Commission[]
  ledger           VendorLedger[]
  refunds          Refund[]
  events           OrderEvent[]

  @@index([storeId, status])
  @@index([customerOrderId])
}

model OrderItem {
  id               String        @id @default(cuid())
  customerOrderId  String
  vendorOrderId    String
  productId        String
  variantId        String
  name             String
  sku              String
  options          Json
  unitPrice        Decimal       @db.Decimal(10, 2)
  quantity         Int
  lineTotal        Decimal       @db.Decimal(10, 2)
  discount         Decimal       @default(0) @db.Decimal(10, 2)
  commissionRate   Decimal       @db.Decimal(5, 2)
  commissionAmount Decimal       @db.Decimal(10, 2)
  customerOrder    CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  vendorOrder      VendorOrder   @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  commission       Commission?
  review           Review?

  @@index([productId])
  @@index([vendorOrderId])
}

model OrderEvent {
  id              String        @id @default(cuid())
  customerOrderId String
  vendorOrderId   String?
  message         String
  createdAt       DateTime      @default(now())
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  vendorOrder     VendorOrder?  @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([customerOrderId, createdAt])
}

model Payment {
  id                String           @id @default(cuid())
  customerOrderId   String
  provider          String
  status            PaymentStatus
  amount            Decimal          @db.Decimal(10, 2)
  currency          String           @default("USD")
  providerIntentId  String?
  idempotencyKey    String?          @unique
  failureReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  customerOrder     CustomerOrder    @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  transactions      PaymentTransaction[]
  refunds           Refund[]

  @@index([customerOrderId])
  @@index([providerIntentId])
}

model PaymentTransaction {
  id          String        @id @default(cuid())
  paymentId   String
  type        String
  amount      Decimal       @db.Decimal(10, 2)
  status      PaymentStatus
  providerRef String?
  raw         Json?
  createdAt   DateTime      @default(now())
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentWebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String
  payload        Json
  signatureValid Boolean
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([provider, eventId])
}

model Refund {
  id               String        @id @default(cuid())
  paymentId        String
  customerOrderId  String
  vendorOrderId    String?
  amount           Decimal       @db.Decimal(10, 2)
  reason           String
  status           RefundStatus
  providerRefundId String?
  restock          Boolean       @default(true)
  createdAt        DateTime      @default(now())
  payment          Payment       @relation(fields: [paymentId], references: [id])
  customerOrder    CustomerOrder @relation(fields: [customerOrderId], references: [id])
  vendorOrder      VendorOrder?  @relation(fields: [vendorOrderId], references: [id])

  @@index([customerOrderId])
}

model Commission {
  id            String           @id @default(cuid())
  vendorOrderId String
  orderItemId   String?          @unique
  source        CommissionSource
  rate          Decimal          @db.Decimal(5, 2)
  baseAmount    Decimal          @db.Decimal(10, 2)
  amount        Decimal          @db.Decimal(10, 2)
  createdAt     DateTime         @default(now())
  vendorOrder   VendorOrder      @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  orderItem     OrderItem?       @relation(fields: [orderItemId], references: [id])

  @@index([vendorOrderId])
}

model VendorLedger {
  id            String      @id @default(cuid())
  storeId       String
  vendorOrderId String?
  payoutId      String?
  type          LedgerType
  amount        Decimal     @db.Decimal(10, 2)
  description   String
  createdAt     DateTime    @default(now())
  store         Store       @relation(fields: [storeId], references: [id])
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id])
  payout        Payout?     @relation(fields: [payoutId], references: [id])

  @@index([storeId, createdAt])
}

model Payout {
  id                String       @id @default(cuid())
  storeId           String
  amount            Decimal      @db.Decimal(10, 2)
  currency          String       @default("USD")
  status            PayoutStatus @default(PENDING)
  periodStart       DateTime?
  periodEnd         DateTime?
  provider          String       @default("mock")
  providerPayoutId  String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  store             Store        @relation(fields: [storeId], references: [id])
  ledger            VendorLedger[]

  @@index([storeId, status])
}

model Shipment {
  id             String         @id @default(cuid())
  vendorOrderId  String
  carrier        String
  trackingNumber String
  status         ShipmentStatus
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vendorOrder    VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
  @@index([trackingNumber])
}

model Coupon {
  id           String         @id @default(cuid())
  code         String         @unique
  type         CouponType
  value        Decimal        @db.Decimal(10, 2)
  minOrder     Decimal?       @db.Decimal(10, 2)
  maxDiscount  Decimal?       @db.Decimal(10, 2)
  usageLimit   Int?
  perUserLimit Int?
  startsAt     DateTime?
  expiresAt    DateTime?
  active       Boolean        @default(true)
  storeId      String?
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  store        Store?         @relation(fields: [storeId], references: [id])
  usages       CouponUsage[]
  orders       CustomerOrder[]
}

model CouponUsage {
  id              String        @id @default(cuid())
  couponId        String
  userId          String
  customerOrderId String        @unique
  createdAt       DateTime      @default(now())
  coupon          Coupon        @relation(fields: [couponId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model Review {
  id             String       @id @default(cuid())
  productId      String
  userId         String
  orderItemId    String?      @unique
  rating         Int
  title          String
  body           String
  status         ReviewStatus @default(PENDING)
  vendorResponse String?
  images         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  orderItem      OrderItem?   @relation(fields: [orderItemId], references: [id])

  @@unique([productId, userId])
  @@index([productId, status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model StoreSetting {
  id      String @id @default(cuid())
  storeId String
  key     String
  value   Json
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
}

model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
